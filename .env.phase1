# Phase 1 Environment Configuration
# Core System Validation & Hardening

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trading_password_2024
DATABASE_URL=postgresql+asyncpg://postgres:trading_password_2024@localhost:5432/trading_system

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=trading_analytics
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=clickhouse_password_2024
CLICKHOUSE_URL=http://clickhouse_user:clickhouse_password_2024@localhost:8123/trading_analytics

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_2024
REDIS_DB=0
REDIS_URL=redis://:redis_password_2024@localhost:6379/0

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# DuckDB Configuration
DUCKDB_PATH=./database/trading_analytics.duckdb

# =============================================================================
# Kafka Configuration
# =============================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONSUMER_GROUP=trading_system
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Configuration
SECRET_KEY=phase1-ultra-secure-secret-key-for-jwt-tokens-change-in-production-2024
JWT_SECRET_KEY=phase1-jwt-secret-key-for-authentication-tokens-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth/OIDC Configuration (Keycloak)
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=trading-system
KEYCLOAK_CLIENT_ID=trading-system-client
KEYCLOAK_CLIENT_SECRET=trading-system-client-secret-2024

# Security Settings
ENABLE_MFA=true
MFA_ISSUER=TradingSystem
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SYMBOLS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true

# =============================================================================
# Trading Configuration
# =============================================================================

# Interactive Brokers Configuration
IB_PAPER_TRADING=true
IB_GATEWAY_PORT=7497
IB_CLIENT_ID=0
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true

# Market Data Configuration
PRIMARY_DATA_SOURCE=IBKR
FALLBACK_DATA_SOURCES=yahoo_finance,alpha_vantage,finnhub
YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# =============================================================================
# API Configuration
# =============================================================================

# Core API Settings
API_V1_STR=/api/v1
API_HOST=localhost
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_DEBUG=true

# CORS Settings
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8090

# =============================================================================
# Feature Flags
# =============================================================================

FEATURE_REAL_TIME_TRADING=false
FEATURE_BACKTESTING=true
FEATURE_OPTIMIZATION=true
FEATURE_PAPER_TRADING=true
FEATURE_AI_ASSISTANT=true
FEATURE_VOICE_TRADING=false
FEATURE_STRATEGY_MARKETPLACE=false

# =============================================================================
# Monitoring & Observability
# =============================================================================

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PUSH_GATEWAY=http://localhost:9091

# Grafana Configuration
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=grafana_api_key_2024

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=trading-system

# =============================================================================
# Object Storage (MinIO)
# =============================================================================

MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=trading_minio_user
MINIO_SECRET_KEY=trading_minio_password_2024
MINIO_BUCKET_NAME=trading-system-data
MINIO_SECURE=false

# =============================================================================
# Environment Settings
# =============================================================================

ENVIRONMENT=phase1_development
DEBUG=true
LOG_LEVEL=INFO
TESTING=false
PYTHONPATH=.

# =============================================================================
# Performance Settings
# =============================================================================

# Database Performance
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Kafka Performance
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=5
KAFKA_BUFFER_MEMORY=33554432
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_ACKS=all
KAFKA_RETRIES=2147483647

# API Performance
API_KEEPALIVE_TIMEOUT=5
API_MAX_REQUESTS=1000
API_TIMEOUT=30

# =============================================================================
# Backup & Recovery
# =============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups
RTO_TARGET_MINUTES=15
RPO_TARGET_MINUTES=5

# =============================================================================
# Health Check Configuration
# =============================================================================

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# Circuit Breaker Configuration
# =============================================================================

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# =============================================================================
# Phase 1 Specific Settings
# =============================================================================

PHASE1_VALIDATION_MODE=true
PHASE1_TARGET_COMPLETION=100
PHASE1_PERFORMANCE_BENCHMARKS=true
PHASE1_SECURITY_HARDENING=true
PHASE1_DATABASE_OPTIMIZATION=true
PHASE1_KAFKA_THROUGHPUT_TEST=true
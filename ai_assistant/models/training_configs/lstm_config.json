{
  "model_type": "lstm",
  "description": "LSTM Neural Network Configuration for Stock Price Prediction",
  "default_config": {
    "prediction_horizon": 7,
    "lookback_window": 60,
    "features": [
      "closing_price",
      "daily_volume",
      "daily_high",
      "daily_low",
      "sma_20",
      "sma_50",
      "rsi_14",
      "macd_line",
      "volatility_20d"
    ],
    "scaling_method": "standard",
    "hyperparameters": {
      "hidden_size": 128,
      "num_layers": 2,
      "dropout": 0.2,
      "learning_rate": 0.001,
      "batch_size": 32,
      "epochs": 100,
      "patience": 10,
      "bidirectional": false,
      "use_attention": false,
      "weight_decay": 1e-5,
      "gradient_clip": 1.0
    }
  },
  "optimization_space": {
    "hidden_size": {
      "type": "categorical",
      "choices": [64, 128, 256, 512]
    },
    "num_layers": {
      "type": "int",
      "low": 1,
      "high": 4
    },
    "dropout": {
      "type": "float",
      "low": 0.1,
      "high": 0.5
    },
    "learning_rate": {
      "type": "loguniform",
      "low": 1e-4,
      "high": 1e-2
    },
    "batch_size": {
      "type": "categorical",
      "choices": [16, 32, 64, 128]
    },
    "bidirectional": {
      "type": "categorical",
      "choices": [true, false]
    },
    "use_attention": {
      "type": "categorical",
      "choices": [true, false]
    }
  },
  "training_config": {
    "train_test_split": 0.8,
    "validation_split": 0.2,
    "cv_folds": 5,
    "optimize_hyperparams": true,
    "n_trials": 50,
    "optimization_timeout": 3600,
    "optimization_metric": "rmse"
  },
  "performance_expectations": {
    "rmse_range": [2.0, 4.0],
    "mae_range": [1.5, 3.0],
    "directional_accuracy_range": [0.55, 0.75],
    "training_time_range": [300, 1800]
  },
  "notes": [
    "LSTM models work best with longer sequences (lookback_window >= 30)",
    "Bidirectional LSTMs may improve performance but increase training time",
    "Attention mechanisms can help with longer sequences but add complexity",
    "Early stopping prevents overfitting - monitor validation loss",
    "GPU acceleration recommended for faster training"
  ]
}
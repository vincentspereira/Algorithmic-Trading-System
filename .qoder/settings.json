{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/build": true,
        "**/dist": true,
        "**/*.egg-info": true,
        "**/node_modules": true,
        "**/logs": true,
        "**/backups": true,
        "**/data": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/build": true,
        "**/dist": true,
        "**/*.egg-info": true,
        "**/node_modules": true,
        "**/logs": true,
        "**/backups": true,
        "**/data": true,
        "**/docs/*(Old*).markdown": true,
        "**/docs/*(Old*).docx": true,
        "**/docs/*(Old*).md": true,
        "**/docs/archive/": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true
    }
}

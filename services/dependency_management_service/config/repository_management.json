  "notification_channels": {
    "slack": {
      "enabled": true,
      "channels": {
        "tier1": "trading-core-deps",
        "tier2": "trading-important-deps",
        "tier3": "trading-support-deps",
        "tier4": "trading-infra-deps"
      }
    },
    "email": {
      "enabled": true,
      "lists": {
        "tier1": ["core-team@company.com", "ccb@company.com"],
        "tier2": ["dev-team@company.com"],
        "tier3": ["dev-team@company.com"],
        "tier4": ["infra-team@company.com"]
      }
    },
    "teams": {
      "enabled": true,
      "channels": {
        "tier1": "Trading Core Dependencies",
        "tier2": "Trading Important Dependencies",
        "tier3": "Trading Support Dependencies",
        "tier4": "Trading Infrastructure"
      }
    }
  },
  "ccb_members": [
    {
      "name": "Technical Lead",
      "email": "tech.lead@company.com",
      "role": "approver"
    },
    {
      "name": "Security Lead",
      "email": "security.lead@company.com",
      "role": "approver"
    },
    {
      "name": "Operations Lead",
      "email": "ops.lead@company.com",
      "role": "approver"
    }
  ],
  "monitoring_config": {
    "vulnerability_scan": {
      "enabled": true,
      "schedule": {
        "tier1": "0 */4 * * *",
        "tier2": "0 0 * * *",
        "tier3": "0 0 * * 0",
        "tier4": "0 0 * * 0"
      }
    },
    "update_check": {
      "enabled": true,
      "schedule": {
        "tier1": "0 */6 * * *",
        "tier2": "0 0 * * *",
        "tier3": "0 0 * * 0",
        "tier4": "0 0 * * 0"
      }
    },
    "health_check": {
      "enabled": true,
      "schedule": {
        "tier1": "*/15 * * * *",
        "tier2": "0 */2 * * *",
        "tier3": "0 */4 * * *",
        "tier4": "0 */6 * * *"
      }
    }
  },
  "testing_config": {
    "tier1": {
      "requires_integration_tests": true,
      "requires_performance_tests": true,
      "requires_security_tests": true,
      "auto_rollback_on_failure": true
    },
    "tier2": {
      "requires_integration_tests": true,
      "requires_performance_tests": false,
      "requires_security_tests": true,
      "auto_rollback_on_failure": true
    },
    "tier3": {
      "requires_integration_tests": false,
      "requires_performance_tests": false,
      "requires_security_tests": true,
      "auto_rollback_on_failure": false
    },
    "tier4": {
      "requires_integration_tests": false,
      "requires_performance_tests": false,
      "requires_security_tests": true,
      "auto_rollback_on_failure": false
    }

{# email_notification.j2 #}
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; }
        .header { padding: 20px; background-color: {% if priority == 'critical' %}#ffebee{% elif priority == 'high' %}#fff3e0{% else %}#e3f2fd{% endif %}; }
        .content { padding: 20px; }
        .details { background-color: #f5f5f5; padding: 15px; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="header">
        <h2>{{ title }}</h2>
        <p>{{ message }}</p>
    </div>
    <div class="content">
        <p><strong>Priority:</strong> {{ priority | upper }}</p>
        <p><strong>Tier:</strong> {{ tier }}</p>
        <p><strong>Time:</strong> {{ timestamp | datetime }}</p>
        
        {% if details %}
        <div class="details">
            <h3>Details:</h3>
            <ul>
            {% for key, value in details.items() %}
                <li><strong>{{ key | title }}:</strong> {{ value }}</li>
            {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</body>
</html>

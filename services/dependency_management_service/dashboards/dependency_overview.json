{
  "uid": "dep-overview",
  "title": "Dependency Overview",
  "tags": ["dependency", "monitoring"],
  "timezone": "",
  "editable": true,
  "style": "dark",
  "panels": [
    {
      "title": "Dependency Performance Score",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dependency_performance_score{tier=\"$tier\", dependency=\"$dependency\"}",
          "legendFormat": "Performance Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Resource Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dependency_resource_usage_cpu{tier=\"$tier\", dependency=\"$dependency\"}",
          "legendFormat": "CPU Usage",
          "refId": "A"
        },
        {
          "expr": "dependency_resource_usage_memory{tier=\"$tier\", dependency=\"$dependency\"}",
          "legendFormat": "Memory Usage",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "Security Alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dependency_security_alerts{tier=\"$tier\", dependency=\"$dependency\"}",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(dependency_errors_total{tier=\"$tier\", dependency=\"$dependency\"}[5m])",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errors/s",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "title": "Update Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dependency_update_status{tier=\"$tier\", dependency=\"$dependency\"}",
          "legendFormat": "Update Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Up to date", "color": "green" },
                "1": { "text": "Update available", "color": "yellow" },
                "2": { "text": "Update required", "color": "red" }
              }
            }
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(dependency_performance_score, tier)",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "dependency",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(dependency_performance_score{tier=\"$tier\"}, dependency)",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5s"
}

{
  "dashboard": {
    "id": null,
    "title": "Algorithmic Trading System - Overview",
    "tags": ["trading", "system", "overview"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"nautilus-trader-engine\"}",
            "legendFormat": "Trading Engine",
            "refId": "A"
          },
          {
            "expr": "up{job=\"ai-assistant\"}",
            "legendFormat": "AI Assistant",
            "refId": "B"
          },
          {
            "expr": "up{job=\"frontend\"}",
            "legendFormat": "Frontend",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "API Response Times",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"nautilus-trader-engine\"}[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"nautilus-trader-engine\"}[5m]))",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Response Time (seconds)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Trading Activity",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(trading_orders_total[5m])",
            "legendFormat": "Orders per second",
            "refId": "A"
          },
          {
            "expr": "rate(trading_executions_total[5m])",
            "legendFormat": "Executions per second",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "System Resource Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{job=\"nautilus-trader-engine\"}[5m]) * 100",
            "legendFormat": "CPU Usage %",
            "refId": "A"
          },
          {
            "expr": "process_resident_memory_bytes{job=\"nautilus-trader-engine\"} / 1024 / 1024",
            "legendFormat": "Memory Usage (MB)",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Database Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "database_connections_active{database=\"postgres\"}",
            "legendFormat": "PostgreSQL",
            "refId": "A"
          },
          {
            "expr": "database_connections_active{database=\"clickhouse\"}",
            "legendFormat": "ClickHouse",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "Kafka Message Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kafka_messages_produced_total[5m])",
            "legendFormat": "Messages Produced/sec",
            "refId": "A"
          },
          {
            "expr": "rate(kafka_messages_consumed_total[5m])",
            "legendFormat": "Messages Consumed/sec",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 16
        }
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 16
        }
      },
      {
        "id": 8,
        "title": "Portfolio Value",
        "type": "graph",
        "targets": [
          {
            "expr": "portfolio_total_value",
            "legendFormat": "Total Portfolio Value",
            "refId": "A"
          },
          {
            "expr": "portfolio_cash_balance",
            "legendFormat": "Cash Balance",
            "refId": "B"
          },
          {
            "expr": "portfolio_unrealized_pnl",
            "legendFormat": "Unrealized P&L",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "Value (USD)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 9,
        "title": "Risk Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "risk_var_1d",
            "legendFormat": "1-Day VaR",
            "refId": "A"
          },
          {
            "expr": "risk_var_10d",
            "legendFormat": "10-Day VaR",
            "refId": "B"
          },
          {
            "expr": "risk_max_drawdown",
            "legendFormat": "Max Drawdown",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "Risk (%)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        }
      },
      {
        "id": 10,
        "title": "Market Data Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(market_data_latency_seconds_bucket[5m])) * 1000",
            "legendFormat": "95th percentile (ms)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(market_data_latency_seconds_bucket[5m])) * 1000",
            "legendFormat": "50th percentile (ms)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Latency (ms)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 32
        }
      },
      {
        "id": 11,
        "title": "Order Execution Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(order_execution_latency_seconds_bucket[5m])) * 1000",
            "legendFormat": "95th percentile (ms)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(order_execution_latency_seconds_bucket[5m])) * 1000",
            "legendFormat": "50th percentile (ms)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Latency (ms)",
            "min": 0
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 32
        }
      },
      {
        "id": 12,
        "title": "AI Assistant Performance",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(ai_assistant_requests_total[5m])",
            "legendFormat": "Requests/sec",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ai_assistant_response_time_seconds_bucket[5m]))",
            "legendFormat": "95th percentile response time",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 32
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
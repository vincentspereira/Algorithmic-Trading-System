# Trae ignore file

# IDE and tool specific
.vscode/
.qoder/
.kiro/
.git/
.idea/

# Python specific
.venv/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
htmlcov/
.tox/

# Node specific
node_modules/

# Data and backups
backups/
data/

# Logs
logs/
*.log

# Documentation
# Ignore old and duplicate documentation files
docs - old/*(Old*).markdown
docs - old/*(Old*).docx
docs - old/*(Old*).md
docs - old/* - Old*.markdown
docs - old/* - Old*.docx
docs - old/* - Old*.md
docs/*(Old*).markdown
docs/*(Old*).docx
docs/*(Old*).md
docs/* - Old*.markdown
docs/* - Old*.docx
docs/* - Old*.md
docs/archive/
docs/complete_designs (Old 1).md
docs/complete_requirements (Old 1).md
docs/complete_tasks (Old 1).md
docs/comprehensive_system_architecture (Old 1).md
docs/comprehensive_system_architecture (Old 2).md

# Other
.env*
*.bak
*.swp

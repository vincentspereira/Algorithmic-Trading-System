              },
              {
                "expr": "node:disk_write_bytes:rate5m",
                "legendFormat": "Write {{instance}}"
              }
            ],
            "yAxes": [
              {
                "label": "Bytes/sec",
                "min": 0
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 0,
              "y": 8
            }
          },
          {
            "id": 19,
            "title": "Network I/O",
            "type": "graph",
            "targets": [
              {
                "expr": "node:network_receive_bytes:rate5m",
                "legendFormat": "Receive {{instance}}"
              },
              {
                "expr": "node:network_transmit_bytes:rate5m",
                "legendFormat": "Transmit {{instance}}"
              }
            ],
            "yAxes": [
              {
                "label": "Bytes/sec",
                "min": 0
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 12,
              "y": 8
            }
          },
          {
            "id": 20,
            "title": "Service Availability",
            "type": "heatmap",
            "targets": [
              {
                "expr": "service:availability:rate24h",
                "legendFormat": "{{job}}"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 24,
              "x": 0,
              "y": 16
            }
          }
        ],
        "time": {
          "from": "now-6h",
          "to": "now"
        },
        "refresh": "1m"
      }
    },
    {
      "dashboard": {
        "id": null,
        "title": "Algorithmic Trading System - Kafka Monitoring",
        "tags": ["trading-system", "kafka", "messaging"],
        "timezone": "browser",
        "panels": [
          {
            "id": 21,
            "title": "Kafka Throughput",
            "type": "graph",
            "targets": [
              {
                "expr": "kafka:messages_in:rate5m",
                "legendFormat": "Messages In/sec"
              },
              {
                "expr": "kafka:bytes_in:rate5m",
                "legendFormat": "Bytes In/sec"
              },
              {
                "expr": "kafka:bytes_out:rate5m",
                "legendFormat": "Bytes Out/sec"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 0,
              "y": 0
            }
          },
          {
            "id": 22,
            "title": "Consumer Lag",
            "type": "graph",
            "targets": [
              {
                "expr": "kafka:consumer_lag:max_5m",
                "legendFormat": "Max Lag"
              },
              {
                "expr": "kafka:consumer_lag:avg_5m",
                "legendFormat": "Avg Lag"
              }
            ],
            "gridPos": {
              "h": 8,
              "w": 12,
              "x": 12,
              "y": 0
            }
          },
          {
            "id": 23,
            "title": "Partition Health",
            "type": "stat",
            "targets": [
              {
                "expr": "kafka:under_replicated_partitions:count",
                "legendFormat": "Under Replicated"
              },
              {
                "expr": "kafka:offline_partitions:count",
                "legendFormat": "Offline"
              }
            ],
            "fieldConfig": {
              "defaults": {
                "thresholds": {
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            },
            "gridPos": {
              "h": 8,
              "w": 24,
              "x": 0,
              "y": 8
            }
          }
        ],
        "time": {
          "from": "now-1h",
          "to": "now"
        },
        "refresh": "30s"
      }
    }
  ]
}
MAX_DAILY_LOSS=10000.00     # Virtual loss limit
MAX_LEVERAGE=2.0             # Conservative leverage for testing
MAX_CONCENTRATION=0.20       # Position concentration limit

# AI/ML Configuration (Optional for Paper Trading)

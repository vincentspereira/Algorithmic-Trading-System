# Interactive Brokers Configuration (PRIMARY BROKER)
# Currently configured for Paper Trading (FREE)
# For Live Trading: Change IB_PAPER_TRADING=false and IB_GATEWAY_PORT=7496
IB_GATEWAY_HOST=localhost
IB_GATEWAY_PORT=7497  # Paper trading port (7496 for live trading)
IB_CLIENT_ID=0
IB_PAPER_TRADING=true  # Paper trading mode (change to false for live trading)
IB_ACCOUNT_NUMBER=DUK221396

#IB API Details for Paper Trading Account:
#-	Host: 127.0.0.1
#-	Port: 7497 (Paper Trading port)
#-	Client ID: 0
#-	IBKR Account No.: DUK221396
#-	The `ibapi` folder is located at the following address: “C:/TWS API/source/pythonclient”


# Trading Safety Flags
ENABLE_LIVE_TRADING=false  # SAFETY: Keep false during paper trading
ENABLE_PAPER_TRADING=true  # Paper trading enabled
ENABLE_BACKTESTING=true

# Additional Broker Configurations (FUTURE INTEGRATIONS)

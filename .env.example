# Algorithmic Trading System - Environment Configuration
# Copy this file to .env and update the values as needed

# PostgreSQL Configuration
POSTGRES_USER=trading_admin
POSTGRES_PASSWORD=secure_trading_password_2024
POSTGRES_DB=trading_system
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@trading.com
PGADMIN_DEFAULT_PASSWORD=admin_password

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password

# API & Security
SECRET_KEY=your-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# LobeChat
OPENAI_API_KEY="dummy-key-for-local-adapter"

# Qdrant
QDRANT_API_KEY=

# HuggingFace
HUGGINGFACE_TOKEN=

# Unstructured.io
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=trading_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# DuckDB Configuration
DUCKDB_DATABASE_PATH=/app/data/duckdb/trading_research.duckdb

# Nautilus Trader Engine Configuration
NAUTILUS_TRADER_HOST=0.0.0.0
NAUTILUS_TRADER_PORT=8000
NAUTILUS_TRADER_RELOAD=true
ENVIRONMENT=development

# Prometheus Configuration
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# JMX Exporter Configuration
JMX_EXPORTER_PORT=5556

# Schema Registry Configuration
SCHEMA_REGISTRY_HOST=schema-registry
SCHEMA_REGISTRY_PORT=8081

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Sources Configuration
YAHOO_FINANCE_ENABLED=true
FINNHUB_API_KEY=your_finnhub_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Interactive Brokers Configuration
IB_GATEWAY_HOST=localhost
IB_GATEWAY_PORT=7497
IB_CLIENT_ID=1
IB_PAPER_TRADING=true

# Risk Management Configuration
MAX_POSITION_SIZE=100000.00
MAX_DAILY_LOSS=10000.00
MAX_LEVERAGE=2.0
MAX_CONCENTRATION=0.20

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
ENABLE_AI_ASSISTANT=false

# Monitoring and Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=false

# Development Configuration
DEBUG=false
TESTING=false